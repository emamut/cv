---
import 'hotkeypad/reset.css'
import 'hotkeypad/index.css'
import '@tabler/icons-webfont/dist/tabler-icons.min.css';

import { getProfiles } from '../lib/datocms'
interface Profile {
  network: string
  url: string
  icon: string
}

const profiles: Profile[] = await getProfiles()

const { lng } = Astro.props

const translations = lng === 'en'
  ? {
      title: "Press <kbd>Cmd</kbd> + <kbd>K</kbd> to open command palette",
      print: "Download Resume (ATS PDF)",
      pdfUrl: "/cv-faber-vergara-en.pdf",
      pdfFilename: "Faber_Vergara_Resume.pdf",
      visit: "Visit",
      search: "Search command...",
      translateText: "Switch to Spanish",
      translateLink: "/esp/",
      themeText: "Toggle Dark/Light Mode"
    }
  : {
      title: 'Presiona <kbd>Cmd</kbd> + <kbd>K</kbd> para abrir el panel de comandos',
      print: "Descargar Hoja de Vida (ATS PDF)",
      pdfUrl: "/cv-faber-vergara-es.pdf",
      pdfFilename: "Faber_Vergara_CV.pdf",
      visit: "Visitar",
      search: "Buscar comando...",
      translateText: "Cambiar a Inglés",
      translateLink: "/",
      themeText: "Alternar Modo Claro / Oscuro"
    }

const profilesInfo = profiles.map(({ network, url, icon }) => {
  let firstLetter = network[0].toUpperCase()

  return {
    id: network,
    section: "Social",
    title: `${translations.visit} ${network}`,
    url,
    icon: `<i class="ti ti-brand-${icon}"></i>`,
    hotkey: `ctrl+${firstLetter}`,
  }
})
---

<footer id="normal-footer" class="no-print" set:html={translations.title}></footer>

<div id="footer-button" class="no-print" title="Command palette" aria-label="Command palette">
  <i class="ti ti-command"></i>
</div>

<div
  id="hotkeypad"
  data-placeholder={translations.search}
  data-info={JSON.stringify(profilesInfo)}
  data-translations={JSON.stringify(translations)}
>
</div>

<script>
  interface Info {
    id: string
    section: string
    title: string
    url: string
    icon: string
    hotkey: string
    handler?: () => void
  }

  import HotKeyPad from "hotkeypad"

  const hotkeypad = new HotKeyPad()
  const info = hotkeypad.instance.getAttribute("data-info") ?? "[]"
  const parsedInfo = JSON.parse(info) as Info[]

  const hotkeypadElement = document.getElementById("hotkeypad");
  const translationsData = hotkeypadElement?.getAttribute("data-translations") ?? "{}";
  const translations = JSON.parse(translationsData);

  const modKey = (hotkeypad.activationKey ?? "ctrl").toLowerCase();

  const data = parsedInfo.map(
    ({ url, hotkey, icon, id, section, title }) => {
      const letter = hotkey.split("+").pop() ?? "";
      return {
        id,
        title,
        icon,
        hotkey: `${modKey}+${letter}`,
        section,
        handler: () => {
          window.open(url, "_blank")
        }
      }
    }
  )

  hotkeypad.setCommands([
    {
      id: "print",
      title: translations.print,
      icon: `<i class="ti ti-file-download"></i>`,
      hotkey: `${modKey}+P`,
      section: "Actions",
      handler: () => {
        const link = document.createElement('a');
        link.href = translations.pdfUrl;
        link.download = translations.pdfFilename;
        link.target = '_blank';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      }
    },
    {
      id: "translate",
      title: translations.translateText,
      icon: `<i class="ti ti-language"></i>`,
      hotkey: `${modKey}+E`,
      section: "Actions",
      handler: () => {
        window.location.href = translations.translateLink;
      }
    },
    {
      id: "theme",
      title: translations.themeText,
      icon: `<i class="ti ti-sun"></i>`,
      hotkey: `${modKey}+D`,
      section: "Actions",
      handler: () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      }
    },
    ...data
  ])

  const footerButton = document.getElementById("footer-button")
  footerButton?.addEventListener("click", () => {
    hotkeypad.open();
  })
</script>

<style>
  #normal-footer {
    display: none;
  }

  #footer-button {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: all 0.2s ease;
    z-index: 40;
  }

  #footer-button:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
    transform: scale(1.05);
  }

  #footer-button i {
    font-size: 1.2rem;
  }

  /* Hotkeypad Theme Styles */
  :global(#hotkeypad [data-backdrop]) {
    background: rgba(0, 0, 0, 0.6) !important;
    backdrop-filter: blur(4px) !important;
  }

  :global(#hotkeypad [data-container]) {
    background: var(--color-surface) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: var(--shadow-lg) !important;
    color: var(--color-text-primary) !important;
  }

  :global(#hotkeypad input) {
    color: var(--color-text-primary) !important;
    background: transparent !important;
    border-bottom: 1px solid var(--color-border) !important;
  }

  :global(#hotkeypad [data-hotkey]) {
    color: var(--color-text-secondary) !important;
    border-radius: var(--radius-sm) !important;
    transition: background-color 0.15s ease !important;
  }

  :global(#hotkeypad [data-hotkey][data-active]) {
    background: var(--color-surface-subtle) !important;
    color: var(--color-text-primary) !important;
  }

  :global(#hotkeypad [data-hotkey] p) {
    color: inherit !important;
  }

  :global(#hotkeypad [data-hotkey] div) {
    display: flex !important;
    align-items: center !important;
    gap: 0.35rem !important;
  }

  :global(#hotkeypad [data-hotkey] div span) {
    width: auto !important;
    min-width: 1.5rem !important;
    height: 1.5rem !important;
    padding: 0 0.45rem !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    background: var(--color-kbd-bg) !important;
    border: 1px solid var(--color-kbd-border) !important;
    color: var(--color-text-muted) !important;
    border-radius: var(--radius-sm) !important;
    font-size: 0.75rem !important;
    font-family: inherit !important;
    font-weight: 500 !important;
    line-height: 1 !important;
    white-space: nowrap !important;
    box-sizing: border-box !important;
    text-transform: capitalize !important;
  }

  :global(#hotkeypad [data-hotkey]:hover div span),
  :global(#hotkeypad [data-hotkey][data-active] div span) {
    background: var(--color-surface) !important;
    border-color: var(--color-border-hover) !important;
    color: var(--color-text-primary) !important;
  }

  :global(#hotkeypad kbd) {
    background: var(--color-kbd-bg) !important;
    border: 1px solid var(--color-kbd-border) !important;
    color: var(--color-text-muted) !important;
  }
</style>
