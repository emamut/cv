---
import 'hotkeypad/reset.css'
import 'hotkeypad/index.css'
import '@tabler/icons-webfont/dist/tabler-icons.min.css';

import { getProfiles } from '../lib/datocms'
interface Profile {
  network: string
  url: string
  icon: string
}

const profiles: Profile[] = await getProfiles()

const { lng } = Astro.props
const basePath = Astro.url.origin;

const translations = lng === 'en'
  ? {
      title: "Press <kbd>Cmd</kbd> + <kbd>K</kbd> to open command palette",
      print: "Print / Save PDF",
      visit: "Visit",
      search: "Search command...",
      translateText: "Switch to Spanish",
      translateLink: basePath + "/esp",
      themeText: "Toggle Dark/Light Mode"
    }
  : {
      title: 'Presiona <kbd>Cmd</kbd> + <kbd>K</kbd> para abrir el panel de comandos',
      print: "Imprimir / Guardar PDF",
      visit: "Visitar",
      search: "Buscar comando...",
      translateText: "Cambiar a Inglés",
      translateLink: basePath + "/",
      themeText: "Alternar Modo Claro / Oscuro"
    }

const profilesInfo = profiles.map(({ network, url, icon }) => {
  let firstLetter = network[0].toUpperCase()

  return {
    id: network,
    section: "Social",
    title: `${translations.visit} ${network}`,
    url,
    icon: `<i class="ti ti-brand-${icon}"></i>`,
    hotkey: `ctrl+${firstLetter}`,
  }
})
---

<footer id="normal-footer" class="no-print" set:html={translations.title}></footer>

<div id="footer-button" class="no-print" title="Command palette" aria-label="Command palette">
  <i class="ti ti-command"></i>
</div>

<div
  id="hotkeypad"
  data-placeholder={translations.search}
  data-info={JSON.stringify(profilesInfo)}
  data-translations={JSON.stringify(translations)}
>
</div>

<script>
  interface Info {
    id: string
    section: string
    title: string
    url: string
    icon: string
    hotkey: string
    handler?: () => void
  }

  import HotKeyPad from "hotkeypad"

  const hotkeypad = new HotKeyPad()
  const info = hotkeypad.instance.getAttribute("data-info") ?? "[]"
  const parsedInfo = JSON.parse(info) as Info[]

  const hotkeypadElement = document.getElementById("hotkeypad");
  const translationsData = hotkeypadElement?.getAttribute("data-translations") ?? "{}";
  const translations = JSON.parse(translationsData);

  const data = parsedInfo.map(
    ({ url, hotkey, icon, id, section, title }) => {
      return {
        id,
        title,
        icon,
        hotkey,
        section,
        handler: () => {
          window.open(url, "_blank")
        }
      }
    }
  )

  hotkeypad.setCommands([
    {
      id: "print",
      title: translations.print,
      icon: `<i class="ti ti-printer"></i>`,
      hotkey: "ctrl+P",
      section: "Actions",
      handler: () => {
        window.print()
      }
    },
    {
      id: "translate",
      title: translations.translateText,
      icon: `<i class="ti ti-language"></i>`,
      hotkey: "ctrl+L",
      section: "Actions",
      handler: () => {
        window.location.href = translations.translateLink;
      }
    },
    {
      id: "theme",
      title: translations.themeText,
      icon: `<i class="ti ti-sun"></i>`,
      hotkey: "ctrl+T",
      section: "Actions",
      handler: () => {
        const isDark = document.documentElement.classList.contains('dark');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
      }
    },
    ...data
  ])

  const footerButton = document.getElementById("footer-button")
  footerButton?.addEventListener("click", () => {
    hotkeypad.open();
  })
</script>

<style>
  #normal-footer {
    display: none;
  }

  #footer-button {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--color-text-secondary);
    transition: all 0.2s ease;
    z-index: 40;
  }

  #footer-button:hover {
    color: var(--color-text-primary);
    border-color: var(--color-border-hover);
    transform: scale(1.05);
  }

  #footer-button i {
    font-size: 1.2rem;
  }

  /* Hotkeypad Theme Styles */
  :global(#hotkeypad [data-backdrop]) {
    background: rgba(0, 0, 0, 0.6) !important;
    backdrop-filter: blur(4px) !important;
  }

  :global(#hotkeypad [data-container]) {
    background: var(--color-surface) !important;
    border: 1px solid var(--color-border) !important;
    border-radius: var(--radius-lg) !important;
    box-shadow: var(--shadow-lg) !important;
    color: var(--color-text-primary) !important;
  }

  :global(#hotkeypad input) {
    color: var(--color-text-primary) !important;
    background: transparent !important;
    border-bottom: 1px solid var(--color-border) !important;
  }

  :global(#hotkeypad [data-item]) {
    color: var(--color-text-secondary) !important;
    border-radius: var(--radius-sm) !important;
  }

  :global(#hotkeypad [data-item][data-selected]) {
    background: var(--color-surface-subtle) !important;
    color: var(--color-text-primary) !important;
  }

  :global(#hotkeypad kbd) {
    background: var(--color-kbd-bg) !important;
    border: 1px solid var(--color-kbd-border) !important;
    color: var(--color-text-muted) !important;
  }
</style>
