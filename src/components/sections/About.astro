---
import Section from "../Section.astro"

interface Props {
  summary: string;
  title: string;
}

const { summary, title } = Astro.props
---

<Section title={title}>
  <p class="about-summary">{summary}</p>
</Section>

<style>
  .about-summary {
    font-size: 0.935rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    text-wrap: pretty;
    margin: 0;
  }

  @media print {
    .about-summary {
      font-size: 9.5pt;
      line-height: 1.45;
      color: #111;
      text-align: left;
    }
  }
</style>
