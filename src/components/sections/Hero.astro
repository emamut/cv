---
import { Image } from "astro:assets"
import gravatarUrl from 'gravatar-url';
import Section from "@/components/Section.astro"

const { basics, profiles } = Astro.props;
const imageURL = basics.image || gravatarUrl(basics.email, { size: 256 });

const linkedInfo = profiles.find(({ network }: { network: string }) => network.toLowerCase() === "linkedin");
const githubInfo = profiles.find(({ network }: { network: string }) => network.toLowerCase() === "github");

const printInfo = [
  basics.email,
  basics.phone,
  basics.city ? `${basics.city}, ${basics.country}` : basics.country,
  linkedInfo?.url?.replace('https://', ''),
  githubInfo?.url?.replace('https://', '')
].filter(Boolean).join("  •  ");
---

<Section className="hero-section">
  <div class="hero-container">
    <div class="hero-info">
      {basics.status && (
        <div class="status-badge no-print">
          <span class="status-indicator"></span>
          <span>{basics.status}</span>
        </div>
      )}

      <h1 class="hero-name">{basics.name}</h1>
      <h2 class="hero-label">{basics.label}</h2>

      <div class="hero-location">
        <i class="ti ti-map-pin"></i>
        <span>{basics.city}, {basics.country}</span>
      </div>

      <!-- Clean ATS Print Info -->
      <div class="hero-print-info print">
        {printInfo}
      </div>

      <!-- Interactive Contact Actions -->
      <div class="hero-actions no-print">
        {basics.email && (
          <a
            href={`mailto:${basics.email}`}
            title={`Email: ${basics.email}`}
            class="action-pill"
          >
            <i class="ti ti-mail"></i>
            <span class="pill-text">Email</span>
          </a>
        )}

        {basics.phone && (
          <a
            href={`tel:${basics.phone}`}
            title={`Phone: ${basics.phone}`}
            class="action-pill"
          >
            <i class="ti ti-phone"></i>
            <span class="pill-text">Llamar</span>
          </a>
        )}

        {profiles.map(({ network, icon, url }: { network: string; icon: string; url: string }) => {
          return (
            <a
              href={url}
              title={`Perfil en ${network}`}
              target="_blank"
              rel="noopener noreferrer"
              class="action-pill"
            >
              <i class={`ti ti-brand-${icon}`}></i>
              <span class="pill-text">{network}</span>
            </a>
          );
        })}
      </div>
    </div>

    <div class="hero-avatar-wrapper">
      <div class="hero-avatar-container">
        <Image
          src={imageURL}
          alt={basics.name}
          width={120}
          height={120}
          loading="eager"
          decoding="async"
          class="hero-avatar"
        />
        <div class="avatar-badge no-print" title="Online / Disponible">
          <span class="avatar-dot"></span>
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .hero-container {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .hero-info {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
    padding: 0.25rem 0.65rem;
    background: var(--color-success-bg);
    border: 1px solid rgba(16, 185, 129, 0.2);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-success);
    margin-bottom: 0.25rem;
  }

  .status-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.25);
    animation: statusPulse 2s infinite ease-in-out;
  }

  @keyframes statusPulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.2);
    }
  }

  .hero-name {
    font-size: 2.15rem;
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.15;
    color: var(--color-text-primary);
    margin: 0;
  }

  .hero-label {
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin: 0;
  }

  .hero-location {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .hero-location i {
    font-size: 1rem;
    color: var(--color-text-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .action-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: 0.8rem;
    font-weight: 500;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: all 0.15s ease;
  }

  .action-pill i {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    transition: color 0.15s ease;
  }

  .action-pill:hover {
    background: var(--color-surface-hover);
    border-color: var(--color-border-hover);
    color: var(--color-text-primary);
    transform: translateY(-1px);
  }

  .action-pill:hover i {
    color: var(--color-accent);
  }

  .hero-avatar-wrapper {
    flex-shrink: 0;
  }

  .hero-avatar-container {
    position: relative;
    width: 112px;
    height: 112px;
  }

  .hero-avatar {
    width: 112px;
    height: 112px;
    object-fit: cover;
    border-radius: 20px;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  .avatar-badge {
    position: absolute;
    bottom: -2px;
    right: -2px;
    background: var(--color-surface);
    padding: 3px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .avatar-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-success);
  }

  .hero-print-info {
    font-size: 0.85rem;
    color: #444;
    line-height: 1.4;
    margin-top: 0.25rem;
  }

  @media (max-width: 640px) {
    .hero-container {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
      gap: 1.5rem;
    }

    .hero-info {
      align-items: center;
    }

    .hero-name {
      font-size: 1.85rem;
    }

    .hero-actions {
      justify-content: center;
    }

    .action-pill .pill-text {
      display: none;
    }

    .action-pill {
      padding: 0.45rem;
      width: 36px;
      height: 36px;
      justify-content: center;
    }
  }

  @media print {
    .hero-container {
      gap: 1rem;
    }

    .hero-name {
      font-size: 1.75rem;
      color: #000;
    }

    .hero-label {
      font-size: 1rem;
      color: #333;
    }

    .hero-avatar {
      width: 90px;
      height: 90px;
      border-radius: 12px;
    }
  }
</style>
