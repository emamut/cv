---
import Section from "../Section.astro"

interface ProjectItem {
  name: string;
  description: string;
  highlights: string[];
  url?: string;
  isActive?: boolean;
  github?: string;
}

interface Props {
  projects: ProjectItem[];
  title: string;
}

const { projects, title } = Astro.props;
---

<Section title={title}>
  <div class="projects-grid">
    {
      projects.map((project) => {
        return (
          <article class="project-card">
            <header class="project-header">
              <div class="project-title-wrapper">
                <h3 class="project-name">
                  {project.url ? (
                    <a
                      href={project.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="project-link"
                      title={`Visitar ${project.name}`}
                    >
                      <span>{project.name}</span>
                      <i class="ti ti-arrow-up-right project-icon"></i>
                    </a>
                  ) : (
                    <span>{project.name}</span>
                  )}
                </h3>
              </div>

              <div class="project-indicators">
                {project.isActive && (
                  <span class="active-dot" title="Proyecto Activo" aria-label="Proyecto Activo"></span>
                )}
                {project.github && (
                  <a
                    href={project.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="github-link no-print"
                    title={`Código fuente de ${project.name}`}
                  >
                    <i class="ti ti-brand-github"></i>
                  </a>
                )}
              </div>
            </header>

            <p class="project-desc">{project.description}</p>

            {project.highlights && project.highlights.length > 0 && (
              <footer class="project-footer">
                {project.highlights.map((highlight) => (
                  <span class="project-tag">{highlight}</span>
                ))}
              </footer>
            )}
          </article>
        );
      })
    }
  </div>
</Section>

<style>
  .projects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.15rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-sm);
    transition: all 0.2s ease;
  }

  .project-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .project-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .project-title-wrapper {
    flex: 1;
  }

  .project-name {
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0;
    color: var(--color-text-primary);
    line-height: 1.3;
  }

  .project-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .project-link:hover {
    color: var(--color-accent);
  }

  .project-icon {
    font-size: 0.85rem;
    opacity: 0.6;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .project-link:hover .project-icon {
    transform: translate(1px, -1px);
    opacity: 1;
  }

  .project-indicators {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .active-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 0 2px var(--color-success-bg);
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 1rem;
    transition: color 0.15s ease;
  }

  .github-link:hover {
    color: var(--color-text-primary);
  }

  .project-desc {
    font-size: 0.825rem;
    line-height: 1.5;
    color: var(--color-text-secondary);
    margin: 0 0 0.85rem;
    flex-grow: 1;
  }

  .project-footer {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: auto;
  }

  .project-tag {
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.12rem 0.45rem;
    border-radius: 4px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    border: 1px solid var(--color-tag-border);
  }

  @media (max-width: 600px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  @media print {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 0.75rem;
    }

    .project-card {
      padding: 0.85rem;
      border-color: #e2e8f0;
      break-inside: avoid;
      box-shadow: none;
    }

    .project-name {
      font-size: 0.9rem;
      color: #000;
    }

    .project-desc {
      font-size: 0.775rem;
      color: #333;
      margin-bottom: 0.5rem;
    }

    .project-tag {
      font-size: 0.65rem;
      background: #f1f5f9;
      color: #333;
    }
  }
</style>
