---
import Layout from "@/layouts/Layout.astro"

import About from "@/components/sections/About.astro"
import Education from "@/components/sections/Education.astro"
import Experience from "@/components/sections/Experience.astro"
import Hero from "@/components/sections/Hero.astro"
import Projects from "@/components/sections/Projects.astro"
import Skills from "@/components/sections/Skills.astro"
import KeyboardManager from "@/components/KeyboardManager.astro"

import {
  getBasic,
  getProfiles,
  getExperiences,
  getEducations,
  getProjects,
  getSkills
} from "../lib/datocms"

const lang = "es"

const basics = await getBasic(lang)
const profiles = await getProfiles()
const work = await getExperiences(lang)
const education = await getEducations(lang)
const projects = await getProjects(lang)
const skills = await getSkills(lang)
---

<Layout
  title={`Hoja de Vida | ${basics?.name || 'Faber Andrés Vergara Holguín'} - ${basics?.label || 'Front End Developer'}`}
  description={basics?.summary || ''}
  lang={lang}
>
  <main class="cv-container">
    <Hero basics={basics} profiles={profiles} lang={lang} />
    <About summary={basics?.summary || ''} title="Sobre mí" />
    <Experience work={work} title="Experiencia Laboral" />
    <Education education={education} title="Educación & Certificaciones" />
    <Projects projects={projects} title="Proyectos Destacados" />
    <Skills skills={skills} title="Habilidades & Tecnologías" />
  </main>

  <KeyboardManager lng={lang} />
</Layout>

<style>
  .cv-container {
    max-width: 740px;
    width: 100%;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 6rem;
  }

  @media (max-width: 700px) {
    .cv-container {
      padding: 1rem 1rem 5rem;
    }
  }

  @media print {
    .cv-container {
      padding: 0;
      max-width: 100%;
      margin: 0;
    }
  }
</style>
